# Port & Host configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL Connection String)
# Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# For connection pooling (PgBouncer), use port 6543
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres

# Supabase Auth Settings
SUPABASE_URL=https://your-supabase-ref.supabase.co
# Found in Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Orchestration Settings (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key
# Selected default model (e.g., google/gemini-2.5-flash, meta-llama/llama-3.1-8b-instruct, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=google/gemini-2.5-flash
